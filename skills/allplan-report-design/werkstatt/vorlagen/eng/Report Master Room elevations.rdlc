 Name="FussLinks"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Report Master   ·   " &amp; Parameters!Project_Name.Value</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>7.5pt</FontSize><Color>#575757</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.3cm</Top><Left>1.5cm</Left><Height>0.45cm</Height><Width>12cm</Width><Style><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox><Textbox Name="FussRechts"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>="Page " &amp; Globals!PageNumber &amp; " / " &amp; Globals!TotalPages</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>7.5pt</FontSize><Color>#575757</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Top>0.3cm</Top><Left>14.5cm</Left><Height>0.45cm</Height><Width>5cm</Width><Style><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox></ReportItems><Style/></PageFooter><PageHeight>29.7cm</PageHeight><PageWidth>21.0cm</PageWidth><LeftMargin>0cm</LeftMargin><RightMargin>0cm</RightMargin><TopMargin>0cm</TopMargin><BottomMargin>0cm</BottomMargin><Style/></Page></ReportSection></ReportSections><ReportParameters>
