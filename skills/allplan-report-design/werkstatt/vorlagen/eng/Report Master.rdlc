Right>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox><Textbox Name="S9_G4_t"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Every component image costs processing time.</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>10pt</FontSize><Color>#062246</Color></Style></TextRun></TextRuns><Style></Style></Paragraph><Paragraph><TextRuns><TextRun><Value>Even if it is never shown: 3,545 rows took 3 to 7 minutes, Allplan “not responding”.</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>8.5pt</FontSize><Color>#062246</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>4.8cm</Top><Left>1.5cm</Left><Height>1.2cm</Height><Width>16.2cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox><Line Name="S9_G4_r"><Top>4.8cm</Top><Left>0.3cm</Left><Height>0cm</Height><Width>17.4cm</Width><Style><Border><Color>#FFFFFF</Color><Style>Solid</Style><Width>1.5pt</Width></Border></Style></Line></ReportItems><KeepTogether>true</KeepTogether><Top>20.3cm</Top><Left>1.5cm</Left><Height>6.0cm</Height><Width>18.0cm</Width><Style><BackgroundColor>#F6F6F6</BackgroundColor><Border><Style>None</Style></Border></Style></Rectangle><Textbox Name="S9_X09"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>X090  </Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>6.5pt</FontSize><Color>#0F54AC</Color></Style></TextRun><TextRun><Value>Five rows on a light surface, large digit in the number font, headline and follow-up in one text box</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>6.5pt</FontSize><Color>#575757</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>26.4cm</Top><Left>1.5cm</Lef