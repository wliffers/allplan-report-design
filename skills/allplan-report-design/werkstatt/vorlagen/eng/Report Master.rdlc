  </DataSources><DataSets><DataSet Name="AllplanReport"><Query><DataSourceName>DummyDataSource</DataSourceName><CommandText>SELECT
       @498@[Name=Objekt],
       [Name=ObjNr|f=@OBJ@],
       @507@[Name=Bezeichnung],
       @506@[Name=Funktion],
       @508@[Name=Material],
       @209@[Name=Gewerk],
       @220@[Name=Laenge],
       @221@[Name=Dicke],
       @222@[Name=Hoehe],
       @229@[Name=Flaeche],
       @223@[Name=Volumen],
       @10@[Name=Nr],
       @205@[Name=Bild|Projection=9|Width=60|Height=40|Hidden=5|GText=HD_CENTERMIDDLE]
FROM [MODEL_DATA, Filter=@OBJ@.eq.1.or.@OBJ@.eq.3.or.@OBJ@.eq.4.or.@OBJ@.eq.6.or.@OBJ@.eq.704.or.@OBJ@.eq.61.or.@OBJ@.eq.991.or.@OBJ@.eq.992]
</CommandText></Query><Fields><Field Name="Objekt"><DataField>Objekt</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ObjNr"><DataField>ObjNr</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Bezeichnung"><DataField>Bezeichnung</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Funktion"><DataField>Funktion</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Material"><DataField>Material</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Gewerk"><DataField>Gewerk</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Laenge"><DataField>Laenge</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Dicke"><DataField>Dicke</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Hoehe"><DataField>Hoehe</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Flaeche"><DataField>Flaeche</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Volumen"><DataField>Volumen</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Nr"><DataField>Nr</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Bild"><DataField>Bild</DataField><rd:TypeName>System.Byte[]</rd:TypeName></Field></Fields><CaseSensitivity>True</CaseSensitivity><rd:DataSetInfo><rd:DataSetName>AllplanReport</rd:DataSetName><rd:TableName>AllplanTable</rd:TableName></rd:DataSetInfo></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Rectangle Name="Seite1"><ReportItems><Rectangle Name="Band"><ReportItems><Rectangle Name="BandAkzent"><KeepTogether>true</KeepTogether><Top>1.15cm</Top><Left>1.5cm</Left><Height>0.1cm</Height><Width>1.3cm</Width><Style><BackgroundColor>#00FBC8</BackgroundColor><Border><Style>None</Style></Border></Style></Rectangle><Textbox Name="BandOver"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>REPORT MASTER  ·  ALLPLAN 2027</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>8pt</FontSize><Color>#00FBC8</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>1.4cm</Top><Left>1.5cm</Left><Height>0.4cm</Height><Width>12cm</Width><Style><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox><Textbox Name="BandTitel"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Building analysis</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>30pt</FontSize><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>1.85cm</Top><Left>1.5cm</Left><Height>1.45cm</Height><Width>13cm</Width><Style><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox><Textbox Name="BandSub"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!Project_Name.Value &amp; "   ·   " &amp; Format(Parameters!Date.Value, "dd MMM yyyy")</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>9pt</FontSize><Color>#B4BDC8</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>3.3cm</Top><Left>1.5cm</Left><Height>0.55cm</Height><Width>13cm</Width><Style><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox><Textbox Name="BandRechts"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Overview</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>8pt</FontSize><Color>#B4BDC8</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Top>1.4cm</Top><Left>14.5cm</Left><Height>0.4cm</Height><Width>5cm</Width><Style><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox><Textbox Name="BandRechts2"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(IIf(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And Fields!Material.Value &lt;&gt; ""), 1, 0))</Value><Style><FontFamily>=Code.Schrift(3)</FontFamily><FontSize>30pt</FontSize><Format>N0</Format><Color>#FFFFFF</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Top>1.85cm</Top><Left>14.5cm</Left><Height>1.45cm</Height><Width>5cm</Width><Style><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox><Textbox Name="BandRechts3"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Components in model</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>9pt</FontSize><Color>#B4BDC8</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Top>3.3cm</Top><Left>14.5cm</Left><Height>0.55cm</Height><Width>5cm</Width><Style><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox></ReportItems><KeepTogether>true</KeepTogether><Top>0cm</Top><Left>0cm</Left><Height>4.5cm</Height><Width>21.0cm</Width><Style><BackgroundColor>#062246</BackgroundColor><Border><Style>None</Style></Border></Style></Rectangle><Textbox Name="Aussage"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>The components total </Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=Format(Sum(IIf(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And Fields!Material.Value &lt;&gt; ""), CDbl(Fields!Volumen.Value), 0.0)), "#,##0") &amp; " m³"</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>, of which </Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=Format(IIf(Sum(IIf(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And Fields!Material.Value &lt;&gt; ""), CDbl(Fields!Volumen.Value), 0.0)) = 0, 0.0, Sum(IIf(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Volumen.Value), 0.0)) / IIf(Sum(IIf(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And Fields!Material.Value &lt;&gt; ""), CDbl(Fields!Volumen.Value), 0.0)) = 0, 1.0, Sum(IIf(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And Fields!Material.Value &lt;&gt; ""), CDbl(Fields!Volumen.Value), 0.0)))), "0 %")</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value> concrete.</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf(Sum(IIf((Val(Fields!ObjNr.Value)=61), 1, 0)) &gt; 0, " ", "")</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf(Sum(IIf((Val(Fields!ObjNr.Value)=61), 1, 0)) &gt; 0, Format(Sum(IIf((Val(Fields!ObjNr.Value)=61), 1, 0)), "0"), "")</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf(Sum(IIf((Val(Fields!ObjNr.Value)=61), 1, 0)) &gt; 0, " rooms with a total of ", "")</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf(Sum(IIf((Val(Fields!ObjNr.Value)=61), 1, 0)) &gt; 0, Format(Sum(IIf((Val(Fields!ObjNr.Value)=61), CDbl(Fields!Flaeche.Value), 0.0)), "#,##0") &amp; " m²", "")</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf(Sum(IIf((Val(Fields!ObjNr.Value)=61), 1, 0)) &gt; 0, ".", "")</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf((Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)) &gt; 0 And Sum(IIf((Val(Fields!ObjNr.Value)=991), CDbl(Fields!Flaeche.Value), 0.0)) &gt; 0), " The window-to-wall ratio is ", "")</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf((Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)) &gt; 0 And Sum(IIf((Val(Fields!ObjNr.Value)=991), CDbl(Fields!Flaeche.Value), 0.0)) &gt; 0), Format(IIf(Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)) = 0, 0.0, Sum(IIf((Val(Fields!ObjNr.Value)=991), CDbl(Fields!Flaeche.Value), 0.0)) / IIf(Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)) = 0, 1.0, Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)))), "0 %"), "")</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf((Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)) &gt; 0 And Sum(IIf((Val(Fields!ObjNr.Value)=991), CDbl(Fields!Flaeche.Value), 0.0)) &gt; 0), IIf(IIf(Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)) = 0, 0.0, Sum(IIf((Val(Fields!ObjNr.Value)=991), CDbl(Fields!Flaeche.Value), 0.0)) / IIf(Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)) = 0, 1.0, Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)))) &lt; Parameters!Ziel_Fensteranteil.Value / 100, ", below", ", above"), "")</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>11.5pt</FontSize><Color>=IIf(IIf(Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)) = 0, 0.0, Sum(IIf((Val(Fields!ObjNr.Value)=991), CDbl(Fields!Flaeche.Value), 0.0)) / IIf(Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)) = 0, 1.0, Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)))) &lt; Parameters!Ziel_Fensteranteil.Value / 100, "#A26807", "#0C855D")</Color></Style></TextRun><TextRun><Value>=IIf((Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)) &gt; 0 And Sum(IIf((Val(Fields!ObjNr.Value)=991), CDbl(Fields!Flaeche.Value), 0.0)) &gt; 0), " the target of ", "")</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf((Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)) &gt; 0 And Sum(IIf((Val(Fields!ObjNr.Value)=991), CDbl(Fields!Flaeche.Value), 0.0)) &gt; 0), Format(Parameters!Ziel_Fensteranteil.Value / 100, "0 %"), "")</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf((Sum(IIf(((Val(Fields!ObjNr.Value)=1) And (Code.MatArt(Fields!Material.Value) = "Concrete")), CDbl(Fields!Flaeche.Value), 0.0)) &gt; 0 And Sum(IIf((Val(Fields!ObjNr.Value)=991), CDbl(Fields!Flaeche.Value), 0.0)) &gt; 0), ".", "")</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>11.5pt</FontSize><Color>#062246</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>4.7cm</Top><Left>1.5cm</Left><Height>1.25cm</Height><Width>18.0cm</Width><Style><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox><Textbox Name="E01_e"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>K010  </Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>6.5pt</FontSize><Color>#0F54AC</Color></Style></TextRun><TextRun><Value>Sentence built from expressions (Sum, IIf, Format); half-sentences without a basis are dropped, concrete via the material group</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>6.5pt</FontSize><Color>#575757</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>6.0cm</Top><Left>1.5cm</Left><Height>0.4cm</Height><Width>18.0cm</Width><Style><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox><Rectangle Name="K1"><ReportItems><Rectangle Name="K1_a"><KeepTogether>true</KeepTogether><Top>0cm</Top><Left>0cm</Left><Height>0.09cm</Height><Width>3.36cm</Width><Style><BackgroundColor>#0F54AC</BackgroundColor><Border><Style>None</Style></Border></Style></Rectangle><Textbox Name="K1_v"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Sum(IIf((Val(Fields!ObjNr.Value)=1), CDbl(Fields!Flaeche.Value), 0.0)), "N0")</Value><Style><FontFamily>=Code.Schrift(3)</FontFamily><FontSize>=IIf(Len(Format(Sum(IIf((Val(Fields!ObjNr.Value)=1), CDbl(Fields!Flaeche.Value), 0.0)), "N0")) &gt;= 8, "14pt", IIf(Len(Format(Sum(IIf((Val(Fields!ObjNr.Value)=1), CDbl(Fields!Flaeche.Value), 0.0)), "N0")) &gt;= 6, "18pt", "22pt"))</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value> m²</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>10pt</FontSize><Color>#575757</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>0.42cm</Top><Left>0.32cm</Left><Height>1.05cm</Height><Width>2.96cm</Width><Style><VerticalAlign>Bottom</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox><Textbox Name="K1_l"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>WALL AREA</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>7pt</FontSize><Color>#062246</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Paragraphs><Top>1.5cm</Top><Left>0.32cm</Left><Height>0.37cm</Height><Width>2.96cm</Width><Style><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom></Style></Textbox><Textbox Name="K1_n"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>all layers</V