7</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><Top>4.75cm</Top><Left>10.7cm</Left><Height>2.75cm</Height><Width>0.42cm</Width><Style><VerticalAlign>Middle</VerticalAlign><PaddingLeft>0pt</PaddingLeft><PaddingRight>0pt</PaddingRight><PaddingTop>0pt</PaddingTop><PaddingBottom>0pt</PaddingBottom><WritingMode>Rotate270</WritingMode></Style></Textbox><Line Name="S8_RandL"><Top>4.75cm</Top><Left>11.2cm</Left><Height>2.75cm</Height><Width>0cm</Width><Style><Border><Color>#E7E7E7</Color><Style>Solid</Style><Width>0.75pt</Width></Border></Style></Line><Textbox Name="S8_Fliess"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>The building consists of </Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>9.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=Format(Sum(IIf(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And Fields!Material.Value &lt;&gt; ""), 1, 0)), "N0")</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>9.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value> components with a total of </Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>9.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf(Abs(Sum(IIf(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And Fields!Material.Value &lt;&gt; ""), CDbl(Fields!Volumen.Value), 0.0))) &gt;= 100, Format(Sum(IIf(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And Fields!Material.Value &lt;&gt; ""), CDbl(Fields!Volumen.Value), 0.0)), "N0"), Format(Sum(IIf(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fiel