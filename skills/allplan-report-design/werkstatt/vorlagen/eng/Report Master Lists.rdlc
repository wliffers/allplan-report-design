  </DataSources><DataSets><DataSet Name="AllplanReport"><Query><DataSourceName>DummyDataSource</DataSourceName><CommandText>SELECT
       @498@[Name=Objekt],
       [Name=ObjNr|f=@OBJ@],
       @507@[Name=Bezeichnung],
       @506@[Name=Funktion],
       @508@[Name=Material],
       @209@[Name=Gewerk],
       @220@[Name=Laenge],
       @221@[Name=Dicke],
       @222@[Name=Hoehe],
       @229@[Name=Flaeche],
       @223@[Name=Volumen],
       @10@[Name=Nr]
FROM [MODEL_DATA, Filter=@OBJ@.eq.1.or.@OBJ@.eq.3.or.@OBJ@.eq.4.or.@OBJ@.eq.6.or.@OBJ@.eq.704.or.@OBJ@.eq.61.or.@OBJ@.eq.991.or.@OBJ@.eq.992]
</CommandText></Query><Fields><Field Name="Objekt"><DataField>Objekt</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="ObjNr"><DataField>ObjNr</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Bezeichnung"><DataField>Bezeichnung</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Funktion"><DataField>Funktion</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Material"><DataField>Material</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Gewerk"><DataField>Gewerk</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Laenge"><DataField>Laenge</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Dicke"><DataField>Dicke</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Hoehe"><DataField>Hoehe</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Flaeche"><DataField>Flaeche</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Volumen"><DataField>Volumen</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Nr"><DataField>Nr</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields><CaseSensitivity>True</CaseSensitivity><rd:DataSetInfo><rd:DataSetName>AllplanReport</rd:DataSetName><rd:TableName>AllplanTable</rd:TableName></rd:DataSetInfo></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Rectangle Name="LT_Deckseite"><ReportItems><Rectangle Name="LT_Band"><ReportItems><Rectangle Name="LT_BandAkzent"><KeepTogether>true</KeepTogether><Top>0.1cm</Top><Left>1.5cm</Left><Height>0.1cm</Height><Width>1.3cm</Width><Style><BackgroundColor>#00FBC8</BackgroundColor><Border><Style>None</Style></Border></Style></Rectangle><Textbox Name="LT_BandOver"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>REPORT MASTER  ·  COMPANION REPORT</Value><Style><FontFamily>=Code.Schrift(2)</FontF