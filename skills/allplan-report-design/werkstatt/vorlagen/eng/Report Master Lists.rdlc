  <ReportParameter Name="Auswertung_Gruppe"><DataType>String</DataType><DefaultValue><Values><Value>Object type</Value></Values></DefaultValue><Prompt>Evaluation of your choice: Group by</Prompt><ValidValues><ParameterValues><ParameterValue><Value>Object type</Value><Label>Object type</Label></ParameterValue><ParameterValue><Value>Material</Value><Label>Material</Label></ParameterValue><ParameterValue><Value>Drawing file</Value><Label>Drawing file</Label></ParameterValue></ParameterValues></ValidValues></ReportParameter><ReportParameter Name="Auswertung_Sortierung"><DataType>String</DataType><DefaultValue><Values><Value>Quantity</Value></Values></DefaultValue><Prompt>Evaluation of your choice: Sort by</Prompt><ValidValues><ParameterValues><ParameterValue><Value>Quantity</Value><Label>Quantity (largest first)</Label></ParameterValue><ParameterValue><Value>Name</Value><Label>Name (A to Z)</Label></ParameterValue></ParameterValues></ValidValues></ReportParameter><ReportParameter Name="Auswertung_Zeilen"><DataType>String</DataType><DefaultValue><Values><Value>10</Value></Values></DefaultValue><Prompt>Evaluation of your choice: How many groups to show (the largest)</Prompt><ValidValues><ParameterValues><ParameterValue><Value>3</Value><Label>3 groups</Label></ParameterValue><ParameterValue><Value>5</Value><Label>5 groups</Label></ParameterValue><ParameterValue><Value>10</Value><Label>10 groups</Label></ParameterValue><ParameterValue><Value>20</Value><Label>20 groups</Label></ParameterValue></ParameterValues></ValidValues></ReportParameter><ReportParameter Name="Etiketten_Art"><DataType>String</DataType><DefaultValue><Values><Value>0</Value></Values></DefaultValue><Prompt>Labels: For which components</Prompt><ValidValues><ParameterValues><ParameterValue><Value>0</Value><Label>All components</Label></ParameterValue><ParameterValue><Value>1</Value><Label>Wall</Label></ParameterValue><ParameterValue><Value>3</Value><Label>Column</Label></ParameterValue><ParameterValue><Value>4</Value><Label>Slab</Label></ParameterValue><ParameterValue><Value>6</Value><Label>Beam</Label></ParameterValue><ParameterValue><Value>704</Value><Label>Floor slab</Label></ParameterValue><ParameterValue><Value>991</Value><Label>Window</Label></ParameterValue><ParameterValue><Value>992</Value><Label>Door</Label></ParameterValue></ParameterValues></ValidValues></ReportParameter><ReportParameter Name="Etiketten_Anzahl"><DataType>String</DataType><DefaultValue><Values><Value>8</Value></Values></DefaultValue><Prompt>Labels: How many (the largest by quantity)</Prompt><ValidValues><ParameterValues><ParameterValue><Value>8</Value><Label>8 labels (1 page)</Label></ParameterValue><ParameterValue><Value>16</Value><Label>16 labels (2 pages)</Label></ParameterValue><ParameterValue><Value>32</Value><Label>32 labels (4 pages)</Label></ParameterValue><ParameterValue><Value>96</Value><Label>96 labels (12 pages)</Label></ParameterValue></ParameterValues></ValidValues></ReportParameter><ReportParameter Name="Material"><DataType>String</DataType><AllowBlank>true</AllowBlank><Prompt>Distinct(Fields!Material.Value)</Prompt><MultiValue>true</MultiValue></ReportParameter></ReportParameters><Code>
Private zuordnung As New System.Collections.Hashtable()
Private stufen() As String = {"#062246", "#0F54AC", "#365F94", "#7597C2", "#A4BEDC", "#D3E4F6", "#E9F1FB", "#E7E7E7"}

' Farbe einer Kategorie: die erste gesehene bekommt den dunkelsten Ton, jede weitere den naechsten.
' Gleicher Name = gleiche Farbe, in jedem Diagramm und jeder Tabelle des Reports.
Public Function Stufe(ByVal name As Object) As String
    Dim key As String = ""
    If Not name Is Nothing Then key = name.ToString()
    If Not zuordnung.ContainsKey(key) Then
        zuordnung(key) = stufen(zuordnung.Count Mod stufen.Length)
    End If
    Return CStr(zuordnung(key))
End Function

' Materialgruppe am Wortstamm erkennen - Projekte benennen dasselbe Material verschieden
' ("Beton bewehrt", "StB C45", "Concrete"; "Masonry", "MW", "KS 20").
Public Function MatArt(ByVal name As Object) As String
    Dim s As String = ""
    If Not name Is Nothing Then s = name.ToString().Trim().ToLower()
    If s = "" Then Return "Not specified"
    If s.Contains("gips") OrElse s.Contains("trockenbau") OrElse s.Contains("gypsum") OrElse s.Contains("plasterboard") OrElse s.Contains("drywall") Then Return "Plasterbd."
    If s.Contains("dämm") OrElse s.Contains("daemm") OrElse s.Contains("wdvs") OrElse s.Contains("isolier") OrElse s.Contains("insulat") OrElse s.Contains("etics") Then Return "Insulation"
    If s.Contains("mauer") OrElse s = "mw" OrElse s.StartsWith("mw ") OrElse s.Contains("ziegel") OrElse s.Contains("kalksand") OrElse s.Contains("porenbeton") OrElse s.StartsWith("ks ") OrElse s.Contains("masonry") OrElse s.Contains("brick") OrElse s.Contains("blockwork") Then Return "Masonry"
    If s.Contains("beton") OrElse s.StartsWith("stb") OrElse s.Contains("concrete") Then Return "Concrete"
    If s.Contains("holz") OrElse s.Contains("wood") OrElse s.Contains("timber") Then Return "Timber"
    If s.Contains("stahl") OrElse s.Contains("steel") Then Return "Steel"
    If s.Contains("glas") Then Return "Glass"   ' trifft auch "glass"
    If s.Contains("stein") OrElse s.Contains("stone") Then Return "Nat. stone"
    Return "Other"
End Function

Public Function MatFarbe(ByVal name As Object) As String
    Select Case MatArt(name)
        Case "Concrete" : Return "#475569"
        Case "Masonry" : Return "#C2410C"
        Case "Insulation" : Return "#EAB308"
        Case "Plasterbd." : Return "#94A3B8"
        Case "Timber" : Return "#A16207"
        Case "Steel" : Return "#0E7490"
        Case "Glass" : Return "#93C5FD"
        Case "Nat. stone" : Return "#78716C"
        Case "Other" : Return "#CBD5E1"
        Case Else : Return "#CBD5E1"
    End Select
End Function

' Bauteilart aus der Allplan-Objektnummer (@OBJ@) - unabhaengig davon, wie das Projekt seine Objekte nennt.
Public Function Art(ByVal nr As Object) As String
    Select Case CInt(Val(nr))
        Case 1 : Return "Wall"
        Case 3 : Return "Column"
        Case 4 : Return "Slab"
        Case 6 : Return "Beam"
        Case 704 : Return "Floor slab"
        Case 61 : Return "Room"
        Case 991 : Return "Window"
        Case 992 : Return "Door"
        Case Else : Return "Other"
    End Select
End Function

' Verkehrsflaeche an der Raumnutzung erkennen.
Public Function IstVerkehr(ByVal funktion As Object) As Boolean
    Dim s As String = ""
    If Not funktion Is Nothing Then s = funktion.ToString().ToLower()
    Return s.Contains("flur") OrElse s.Contains("diele") OrElse s.Contains("gang") OrElse s.Contains("treppe") _
        OrElse s.Contains("verkehr") OrElse s.Contains("foyer") OrElse s.Contains("windfang") OrElse s.Contains("aufzug") _
        OrElse s.Contains("corridor") OrElse s.Contains("hallway") OrElse s.Contains("circulation") OrElse s.Contains("stair") _
        OrElse s.Contains("lobby") OrElse s.Contains("lift") OrElse s.Contains("elevator")
End Function

' Die Auswahl einer Mehrfach-Stellschraube als Text: nur gesetzte Werte, hoechstens grenze Zeichen.
Public Function WahlListe(ByVal v As Object, ByVal grenze As Integer) As String
    Dim s As String = ""
    If v Is Nothing Then Return ""
    If TypeOf v Is Object() Then
        Dim a() As Object = CType(v, Object())
        Dim i As Integer
        For i = 0 To a.Length - 1
            If Not a(i) Is Nothing Then
                If a(i).ToString().Length &gt; 0 Then
                    If s.Length &gt; 0 Then s = s &amp; ", "
                    s = s &amp; a(i).ToString()
                End If
            End If
        Next
    Else
        s = v.ToString()
    End If
    If s.Length &gt; grenze Then s = s.Substring(0, grenze - 1) &amp; "…"
    Return s
End Function

' Ist wert einer der in einer Mehrfach-Stellschraube gewaehlten Werte?
Public Function InWahl(ByVal v As Object, ByVal wert As Object) As Boolean
    If v Is Nothing Then Return False
    Dim s As String = ""
    If Not wert Is Nothing Then s = wert.ToString()
    If TypeOf v Is Object() Then
        Dim a() As Object = CType(v, Object())
        Dim i As Integer
        For i = 0 To a.Length - 1
            If Not a(i) Is Nothing Then
                If a(i).ToString() = s Then Return True
            End If
        Next
        Return False
    End If
    Return v.ToString() = s
End Function

' Nicht leere Teile mit Komma verbinden (die Masse eines Etiketts).
Public Function Verbinde(ByVal a As String, ByVal b As String, ByVal c As String) As String
    Dim s As String = ""
    Dim t As String
    For Each t In New String() {a, b, c}
        If Not t Is Nothing Then
            If t.Trim().Length &gt; 0 Then
                If s.Length &gt; 0 Then s = s &amp; ", "
                s = s &amp; t.Trim()
            End If
        End If
    Next
    Return s
End Function

' Text fuer den QR-Code eines Etiketts, hoechstens grenze Byte in UTF-8 (QrPng liefert sonst ein leeres Bild ohne Fehler).
' Zeilen: kopf (wird gekuerzt, bis es passt), zusatz (faellt weg, wenn er nicht ganz passt), masse, id.
' Reicht der Platz nicht einmal fuer masse und id, bleibt die id allein.
Public Function EtikettText(ByVal kopf As String, ByVal zusatz As String, ByVal masse As String, ByVal id As String, ByVal grenze As Integer) As String
    Dim nl As String = ChrW(10)
    Dim u As System.Text.Encoding = System.Text.Encoding.UTF8
    Dim fest As String = masse &amp; nl &amp; id
    If u.GetByteCount(fest) &gt; grenze Then Return id
    Dim k As String = "" &amp; kopf
    Do While k.Length &gt; 0 AndAlso u.GetByteCount(k &amp; nl &amp; fest) &gt; grenze
        k = k.Substring(0, k.Length - 1)
    Loop
    k = k.TrimEnd()
    If k.Length = 0 Then Return fest
    If Len(zusatz) &gt; 0 AndAlso u.GetByteCount(k &amp; nl &amp; zusatz &amp; nl &amp; fest) &lt;= grenze Then Return k &amp; nl &amp; zusatz &amp; nl &amp; fest
    Return k &amp; nl &amp; fest
End Function

Private Const T39 As String = "-nwnnnnwnw.wwnnnnwnn nwwnnnwnn*nwnnwnwnn$nwnwnwnnn/nwnwnnnwn+nwnnnwnwn%nnnwnwnwn"

Private Const T128 As String = "212222 222122 222221 121223 121322 131222 122213 122312 132212 221213 221312 231212 112232 122132 122231 113222 123122 123221 223211 221132 221231 213212 223112 312131 311222 321122 321221 312212 322112 322211 212123 212321 232121 111323 131123 131321 112313 132113 132311 211313 231113 231311 112133 112331 132131 113123 113321 133121 313121 211331 231131 213113 213311 213131 311123 311321 331121 312113 312311 332111 314111 221411 431111 111224 111422 121124 121421 141122 141221 112214 112412 122114 122411 142112 142211 241211 221114 413111 241112 134111 111242 121142 121241 114212 124112 124211 411212 421112 421211 212141 214121 412121 111143 111341 131141 114113 114311 411113 411311 113141 114131 311141 411131 211412 211214 211232 2331112"

' Code 39 als Modulfolge: "1" = Balken, "0" = Luecke; schmal = 1 Modul, breit = 3 Module. Start und Stopp "*" kommen dazu.
Public Function Modul39(ByVal text As Object) As String
    Dim s As String = "*" &amp; text.ToString().ToUpper() &amp; "*"
    Dim r As New System.Text.StringBuilder()
    Dim k, j, e, p, w As Integer
    For k = 0 To s.Length - 1
        p = -1
        For j = 0 To T39.Length - 10 Step 10
            If T39(j) = s(k) Then
                p = j
                Exit For
            End If
        Next
        If p &lt; 0 Then Return ""
        For e = 1 To 9
            w = 1
            If T39(p + e) = "w"c Then w = 3
            If e Mod 2 = 1 Then
                r.Append("1"c, w)
            Else
                r.Append("0"c, w)
            End If
        Next
        If k &lt; s.Length - 1 Then r.Append("0"c)
    Next
    Return r.ToString()
End Function

' Code 128 Satz B (ASCII 32..126) als Modulfolge, mit Pruefzeichen.
Public Function Modul128(ByVal text As Object) As String
    Dim s As String = text.ToString()
    Dim muster() As String = T128.Split(" "c)
    Dim werte As New System.Collections.Generic.List(Of Integer)
    Dim i, v, summe As Integer
    werte.Add(104)
    summe = 104
    For i = 0 To s.Length - 1
        v = Asc(s(i)) - 32
        If v &lt; 0 OrElse v &gt; 94 Then Return ""
        werte.Add(v)
        summe = summe + v * (i + 1)
    Next
    werte.Add(summe Mod 103)
    werte.Add(106)
    Dim r As New System.Text.StringBuilder()
    Dim d, n As Integer
    Dim balken As Boolean
    For i = 0 To werte.Count - 1
        balken = True
        For d = 0 To muster(werte(i)).Length - 1
            n = Asc(muster(werte(i))(d)) - 48
            If balken Then
                r.Append("1"c, n)
            Else
                r.Append("0"c, n)
            End If
            balken = Not balken
        Next
    Next
    Return r.ToString()
End Function

' Modulfolge als PNG: px Pixel je Modul, hoch Pixel Hoehe, ruhe Module Ruhezone links und rechts.
Public Function ModulPng(ByVal m As String, ByVal px As Integer, ByVal hoch As Integer, ByVal ruhe As Integer) As Byte()
    If m.Length = 0 Then Return Nothing
    Dim bmp As New System.Drawing.Bitmap((m.Length + 2 * ruhe) * px, hoch)
    Dim g As System.Drawing.Graphics = System.Drawing.Graphics.FromImage(bmp)
    g.Clear(System.Drawing.Color.White)
    Dim i As Integer
    For i = 0 To m.Length - 1
        If m(i) = "1"c Then g.FillRectangle(System.Drawing.Brushes.Black, (i + ruhe) * px, 0, px, hoch)
    Next
    g.Dispose()
    Dim ms As New System.IO.MemoryStream()
    bmp.Save(ms, System.Drawing.Imaging.ImageFormat.Png)
    bmp.Dispose()
    Return ms.ToArray()
End Function

Public Function Strichcode39(ByVal text As Object) As Byte()
    Return ModulPng(Modul39(text), 2, 50, 10)
End Function

Public Function Strichcode128(ByVal text As Object) As Byte()
    Return ModulPng(Modul128(text), 2, 50, 10)
End Function

' ---------------------------------------------------------------- QR-Code
Private gfExp(511) As Integer
Private gfLog(255) As Integer
Private gfFertig As Boolean = False

Private Sub GfStart()
    If gfFertig Then Return
    Dim x, i As Integer
    x = 1
    For i = 0 To 254
        gfExp(i) = x
        gfLog(x) = i
        x = x * 2
        If x &gt;= 256 Then x = x Xor 285
    Next
    For i = 255 To 511
        gfExp(i) = gfExp(i - 255)
    Next
    gfFertig = True
End Sub

Private Function GfMul(ByVal a As Integer, ByVal b As Integer) As Integer
    If a = 0 OrElse b = 0 Then Return 0
    Return gfExp(gfLog(a) + gfLog(b))
End Function

' Fehlerkorrektur-Codewoerter (Reed-Solomon) zu den Datenwoertern
Private Function RsRest(ByVal daten() As Integer, ByVal ec As Integer) As Integer()
    GfStart()
    Dim gen(ec) As Integer
    Dim nxt(ec) As Integer
    Dim i, j As Integer
    gen(0) = 1
    For i = 0 To ec - 1
        For j = 0 To ec
            nxt(j) = 0
        Next
        For j = 0 To i
            nxt(j) = nxt(j) Xor gen(j)
            nxt(j + 1) = nxt(j + 1) Xor GfMul(gen(j), gfExp(i))
        Next
        For j = 0 To ec
            gen(j) = nxt(j)
        Next
    Next
    Dim rest(ec - 1) As Integer
    Dim f As Integer
    For i = 0 To daten.Length - 1
        f = daten(i) Xor rest(0)
        For j = 0 To ec - 2
            rest(j) = rest(j + 1)
        Next
        rest(ec - 1) = 0
        For j = 0 To ec - 1
            rest(j) = rest(j) Xor GfMul(gen(j + 1), f)
        Next
    Next
    Return rest
End Function

Private Sub QrSetze(ByVal m(,) As Boolean, ByVal fn(,) As Boolean, ByVal x As Integer, ByVal y As Integer, ByVal v As Boolean)
    m(y, x) = v
    fn(y, x) = True
End Sub

' QR-Matrix: Version 1-5, Byte-Modus, Fehlerkorrektur L, Maske 0. Nothing, wenn der Text nicht passt (hoechstens 106 Bytes).
Public Function QrMatrix(ByVal text As Object) As Boolean(,)
    Dim roh() As Byte = System.Text.Encoding.UTF8.GetBytes(text.ToString())
    Dim dcwTab() As Integer = {19, 34, 55, 80, 108}
    Dim ecwTab() As Integer = {7, 10, 15, 20, 26}
    Dim ver As Integer = 0
    Dim i, j, x, y As Integer
    For i = 1 To 5
        If roh.Length &lt;= dcwTab(i - 1) - 2 Then
            ver = i
            Exit For
        End If
    Next
    If ver = 0 Then Return Nothing
    Dim dcw As Integer = dcwTab(ver - 1)
    Dim ecw As Integer = ecwTab(ver - 1)
    Dim bits As New System.Text.StringBuilder()
    bits.Append("0100")
    bits.Append(Convert.ToString(roh.Length, 2).PadLeft(8, "0"c))
    For i = 0 To roh.Length - 1
        bits.Append(Convert.ToString(CInt(roh(i)), 2).PadLeft(8, "0"c))
    Next
    j = dcw * 8 - bits.Length
    If j &gt; 4 Then j = 4
    bits.Append("0"c, j)
    While bits.Length Mod 8 &lt;&gt; 0
        bits.Append("0"c)
    End While
    Dim daten(dcw - 1) As Integer
    For i = 0 To bits.Length \ 8 - 1
        daten(i) = Convert.ToInt32(bits.ToString(i * 8, 8), 2)
    Next
    For i = bits.Length \ 8 To dcw - 1
        If (i - bits.Length \ 8) Mod 2 = 0 Then
            daten(i) = 236
        Else
            daten(i) = 17
        End If
    Next
    Dim rest() As Integer = RsRest(daten, ecw)
    Dim alle(dcw + ecw - 1) As Integer
    For i = 0 To dcw - 1
        alle(i) = daten(i)
    Next
    For i = 0 To ecw - 1
        alle(dcw + i) = rest(i)
    Next
    Dim n As Integer = 17 + 4 * ver
    Dim m(n - 1, n - 1) As Boolean
    Dim fn(n - 1, n - 1) As Boolean
    For i = 0 To n - 1
        QrSetze(m, fn, 6, i, i Mod 2 = 0)
        QrSetze(m, fn, i, 6, i Mod 2 = 0)
    Next
    Dim ecken() As Integer = {3, 3, n - 4, 3, 3, n - 4}
    Dim dx, dy, d, k As Integer
    For k = 0 To 2
        For dy = -4 To 4
            For dx = -4 To 4
                x = ecken(2 * k) + dx
                y = ecken(2 * k + 1) + dy
                If x &gt;= 0 AndAlso x &lt; n AndAlso y &gt;= 0 AndAlso y &lt; n Then
                    d = System.Math.Max(System.Math.Abs(dx), System.Math.Abs(dy))
                    QrSetze(m, fn, x, y, d &lt;&gt; 2 AndAlso d &lt;&gt; 4)
                End If
            Next
        Next
    Next
    If ver &gt;= 2 Then
        Dim a As Integer = 10 + 4 * ver
        For dy = -2 To 2
            For dx = -2 To 2
                QrSetze(m, fn, a + dx, a + dy, System.Math.Max(System.Math.Abs(dx), System.Math.Abs(dy)) &lt;&gt; 1)
            Next
        Next
    End If
    ' Formatinfo: Stufe L (01), Maske 0, BCH-Rest, Maskierung 0x5412
    Dim rem1 As Integer = 8
    For i = 1 To 10
        rem1 = (rem1 * 2) Xor ((rem1 \ 512) * 1335)
    Next
    Dim fb As Integer = ((8 * 1024) Or rem1) Xor 21522
    For i = 0 To 5
        QrSetze(m, fn, 8, i, (fb \ (2 ^ i)) Mod 2 = 1)
    Next
    QrSetze(m, fn, 8, 7, (fb \ 64) Mod 2 = 1)
    QrSetze(m, fn, 8, 8, (fb \ 128) Mod 2 = 1)
    QrSetze(m, fn, 7, 8, (fb \ 256) Mod 2 = 1)
    For i = 9 To 14
        QrSetze(m, fn, 14 - i, 8, (fb \ (2 ^ i)) Mod 2 = 1)
    Next
    For i = 0 To 7
        QrSetze(m, fn, n - 1 - i, 8, (fb \ (2 ^ i)) Mod 2 = 1)
    Next
    For i = 8 To 14
        QrSetze(m, fn, 8, n - 15 + i, (fb \ (2 ^ i)) Mod 2 = 1)
    Next
    QrSetze(m, fn, 8, n - 8, True)
    ' Daten im Zickzack von rechts unten
    Dim bit As Integer = 0
    Dim rechts As Integer = n - 1
    Dim vert, jj As Integer
    Dim auf As Boolean
    While rechts &gt;= 1
        If rechts = 6 Then rechts = 5
        For vert = 0 To n - 1
            For jj = 0 To 1
                x = rechts - jj
                auf = ((rechts + 1) And 2) = 0
                If auf Then
                    y = n - 1 - vert
                Else
                    y = vert
                End If
                If Not fn(y, x) AndAlso bit &lt; alle.Length * 8 Then
                    m(y, x) = ((alle(bit \ 8) \ (2 ^ (7 - (bit Mod 8)))) Mod 2) = 1
                    bit = bit + 1
                End If
            Next
        Next
        rechts = rechts - 2
    End While
    For y = 0 To n - 1
        For x = 0 To n - 1
            If Not fn(y, x) AndAlso (x + y) Mod 2 = 0 Then m(y, x) = Not m(y, x)
        Next
    Next
    Return m
End Function

' QR-Code als PNG: px Pixel je Modul, Ruhezone 4 Module.
Public Function QrPng(ByVal text As Object, ByVal px As Integer) As Byte()
    Dim m(,) As Boolean = QrMatrix(text)
    If m Is Nothing Then Return Nothing
    Dim n As Integer = m.GetLength(0)
    Dim bmp As New System.Drawing.Bitmap((n + 8) * px, (n + 8) * px)
    Dim g As System.Drawing.Graphics = System.Drawing.Graphics.FromImage(bmp)
    g.Clear(System.Drawing.Color.White)
    Dim x, y As Integer
    For y = 0 To n - 1
        For x = 0 To n - 1
            If m(y, x) Then g.FillRectangle(System.Drawing.Brushes.Black, (x + 4) * px, (y + 4) * px, px, px)
        Next
    Next
    g.Dispose()
    Dim ms As New System.IO.MemoryStream()
    bmp.Save(ms, System.Drawing.Imaging.ImageFormat.Png)
    bmp.Dispose()
    Return ms.ToArray()
End Function

Private rd_schrift() As String = Nothing
Public Function Schrift(ByVal rolle As Integer) As String
    If rd_schrift Is Nothing Then
        Dim soll() As String = {"Roboto", "Roboto Light", "Roboto Medium", "Roboto Black"}
        Dim ersatz() As String = {"Segoe UI", "Segoe UI Light", "Segoe UI Semibold", "Segoe UI Semibold"}
        Dim namen As String = "|"
        Try
            For Each wurzel As Microsoft.Win32.RegistryKey In New Microsoft.Win32.RegistryKey() {Microsoft.Win32.Registry.LocalMachine, Microsoft.Win32.Registry.CurrentUser}
                Dim k As Microsoft.Win32.RegistryKey = wurzel.OpenSubKey("SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts")
                If Not k Is Nothing Then
                    For Each n As String In k.GetValueNames()
                        Dim p As Integer = n.IndexOf(" (")
                        If p &gt; 0 Then n = n.Substring(0, p)
                        For Each teil As String In n.Split("&amp;"c)
                            namen &amp;= teil.Trim().ToLowerInvariant() &amp; "|"
                        Next
                    Next
                    k.Close()
                End If
            Next
        Catch
            namen = ""
        End Try
        Dim alle As Boolean = (namen &lt;&gt; "")
        For i As Integer = 0 To soll.Length - 1
            Dim f As String = soll(i).ToLowerInvariant()
            If Not (namen.Contains("|" &amp; f &amp; "|") OrElse namen.Contains("|" &amp; f &amp; " regular|") OrElse namen.Contains("|" &amp; f &amp; " bold|") OrElse namen.Contains("|" &amp; f &amp; " variable|")) Then alle = False
        Next
        If alle Then rd_schrift = soll Else rd_schrift = ersatz
    End If
    Return rd_schrift(rolle)
End Function
