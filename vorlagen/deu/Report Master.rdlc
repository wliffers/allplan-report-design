f(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And Fields!Material.Value &lt;&gt; ""), CDbl(Fields!Volumen.Value), 0.0)) = 0, 0.0, Sum(IIf((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And (Code.MatArt(Fields!Material.Value) = "Beton"), CDbl(Fields!Volumen.Value), 0.0)) / IIf(Sum(IIf(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And Fields!Material.Value &lt;&gt; ""), CDbl(Fields!Volumen.Value), 0.0)) = 0, 1.0, Sum(IIf(((Val(Fields!ObjNr.Value)=1 Or Val(Fields!ObjNr.Value)=3 Or Val(Fields!ObjNr.Value)=4 Or Val(Fields!ObjNr.Value)=6 Or Val(Fields!ObjNr.Value)=704) And Fields!Material.Value &lt;&gt; ""), CDbl(Fields!Volumen.Value), 0.0))))</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>9.5pt</FontSize><Format>0 %</Format><Color>#0F54AC</Color></Style></TextRun><TextRun><Value> davon sind Beton. </Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>9.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf(Sum(IIf((Val(Fields!ObjNr.Value)=61), 1, 0)) = 0, "", "Auf ")</Value><Style><FontFamily>=Code.Schrift(0)</FontFamily><FontSize>9.5pt</FontSize><Color>#062246</Color></Style></TextRun><TextRun><Value>=IIf(Sum(IIf((Val(Fields!ObjNr.Value)=61), 1, 0)) = 0, "", IIf(Abs(Sum(IIf((Val(Fields!ObjNr.Value)=61), CDbl(Fields!Flaeche.Value), 0.0))) &gt;= 100, Format(Sum(IIf((Val(Fields!ObjNr.Value)=61), CDbl(Fields!Flaeche.Value), 0.0)), "N0"), Format(Sum(IIf((Val(Fields!ObjNr.Value)=61), CDbl(Fields!Flaeche.Value), 0.0)), "N1")))</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>9.5pt</FontSize><Color>#0F54AC</Color></Style></TextRun><TextRun><Value>=IIf(Sum(IIf((Val(Fields!ObjNr.Value)=61), 1, 0)) = 0, "", " m² Raumfl