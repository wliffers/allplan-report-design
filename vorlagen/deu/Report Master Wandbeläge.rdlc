  </DataSources><DataSets><DataSet Name="AllplanReport"><Query><DataSourceName>DummyDataSource</DataSourceName><CommandText>SELECT
       @10@[Name=Nr],
       @209@[Name=Gewerk],
       @508@[Name=Material],
       [Name=Raum|f=PARENT(@507@)],
       [Name=Funktion|f=PARENT(@506@)],
       [Name=RaumNr|f=PARENT(@10@)],
       [Name=Flaeche|Fmt=G12.0|f=QT(@295@;;;;@205@213@)],
       @205@[Name=Bild|Projection=10|Width=120|Height=60|GText=HD],
       @225@[Name=Abmessungen],
       @211@[Name=Dicke],
       @213@[Name=Leibung]
FROM [Type=0,Filter=@OBJ@.eq.62]
</CommandText></Query><Fields><Field Name="Nr"><DataField>Nr</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Gewerk"><DataField>Gewerk</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Material"><DataField>Material</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Raum"><DataField>Raum</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Funktion"><DataField>Funktion</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="RaumNr"><DataField>RaumNr</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Flaeche"><DataField>Flaeche</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Bild"><DataField>Bild</DataField><rd:TypeName>System.Byte[]</rd:TypeName></Field><Field Name="Abmessungen"><DataField>Abmessungen</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Dicke"><DataField>Dicke</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Leibung"><DataField>Leibung</DataField><rd:TypeName>System.Double</rd:TypeName></Field></Fields><CaseSensitivity>True</CaseSensitivity><rd:DataSetInfo><rd:DataSetName>AllplanReport</rd:DataSetName><rd:TableName>AllplanTable</rd:TableName></rd:DataSetInfo></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Rectangle Name="Seite1"><ReportItems><Rectangle Name="W_Band"><ReportItems><Rectangle Name="W_BandAkzent"><KeepTogether>true</KeepTogether><Top>1.15cm</Top><Left>1.5cm</Left><Height>0.1cm</Height><Width>1.3cm</Width><Style><BackgroundColor>#00FBC8</BackgroundColor><Border><Style>None</Style></Border></Style></Rectangle><Textbox Name="W_BandOver"><CanGrow>false</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>REPORT MASTER  ·  BEGLEIT-REPORT</Value><Style><FontFamily>=Code.Schrift(2)</FontFamily><FontSize>8pt</FontSize><Color>#00FBC8</Color></Style></TextRun></TextRuns><Style></Style></Paragraph></Pa