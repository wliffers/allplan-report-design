       @512@[Name=Teilbildnummer],
       @425@[Name=Teilbildname]
FROM [LAYOUT_DRAWINGS]
</CommandText></Query><Fields><Field Name="Plannummer"><DataField>Plannummer</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Planname"><DataField>Planname</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Planindex"><DataField>Planindex</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Erstellt"><DataField>Erstellt</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Geaendert"><DataField>Geaendert</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Ersteller"><DataField>Ersteller</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Pruefer"><DataField>Pruefer</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Freigabe"><DataField>Freigabe</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="Planformat"><DataField>Planformat</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Breite"><DataField>Breite</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Hoehe"><DataField>Hoehe</DataField><rd:TypeName>System.Double</rd:TypeName></Field><Field Name="Teilbildnummer"><DataField>Teilbildnummer</DataField><rd:TypeName>System.Int32</rd:TypeName></Field><Field Name="Teilbildname"><DataField>Teilbildname</DataField><rd:TypeName>System.String</rd:TypeName></Field></Fields><CaseSensitivity>True</CaseSensitivity><rd:DataSetInfo><rd:DataSetName>AllplanReport</rd:DataSetName><rd:TableName>AllplanTable</rd:TableName></rd:DataSetInfo></DataSet></DataSets><ReportSections><ReportSection><Body><ReportItems><Rectangle Name="Seite1"><ReportItems><Rectangle Name="PL_Band"><ReportItems><Rectangle Name="PL_BandAkzent"><KeepTogether>true</KeepTogether><Top>1.15cm</Top><Left>1.5cm</Left><Height>0.1cm</Height><Width>1.3cm</Width><Style><BackgroundColor>#F97316</BackgroundColor><Border><Style>None</Style></Border></Style></Rectangle><Textbox Name="PL_BandOver"><CanGrow>false</CanGrow><Ke